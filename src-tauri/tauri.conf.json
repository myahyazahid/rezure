{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rezureapp",
  "version": "3.0.0",
  "identifier": "com.redscale.rezure",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rezure",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundled-bin/nginx": "bundled-bin/nginx",
      "bundled-bin/php": "bundled-bin/php"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEN0M1RERCQTE1OTZCRDQKUldUVWExbWgyMTE4ZlJ1b2FhT2RMVFRDVVd3MHFFUnFieVVHV0QvYXV2RUw5bTIwcW1YN1U1bTcK",
      "endpoints": [
        "https://api.redscale.my.id/api/v1/version/latest?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ]
    }
  }
}
